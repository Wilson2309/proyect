<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.HistorialController"
      prefHeight="500.0"
      prefWidth="700.0"
      spacing="16"
      styleClass="historial-root"
      stylesheets="@/org/example/styles/historial.css">

    <Label styleClass="historial-title" text="Historial de análisis"/>
    <Label styleClass="historial-subtitle"
           text="Registro automático de acciones y eventos del sistema"/>

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="historial-toolbar">
        <TextField fx:id="searchField"
                   promptText="Buscar en el historial..."
                   styleClass="historial-search"
                   HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="categoryFilter"
                  promptText="Categoría"
                  styleClass="historial-filter"/>
        <Button fx:id="clearButton"
                mnemonicParsing="false"
                onAction="#handleClearHistory"
                styleClass="historial-clear-button"
                text="Limpiar"/>
    </HBox>

    <Label fx:id="resultCountLabel"
           styleClass="historial-count"
           text="0 eventos"/>

    <StackPane VBox.vgrow="ALWAYS">
        <ScrollPane fitToWidth="true"
                    fx:id="historyScroll"
                    styleClass="historial-scroll">

            <VBox fx:id="timelineList"
                  spacing="12"
                  styleClass="historial-timeline">
                <padding>
                    <Insets bottom="8" right="4" top="4"/>
                </padding>
            </VBox>
        </ScrollPane>
    </StackPane>
</VBox>
